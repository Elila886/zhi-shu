# Copy this file to .env and fill in your local secrets. Never commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=openai
MODEL_NAMES=["gpt-4o","gpt-4o-mini"]
MODEL_BASE_URL=
EMBEDDINGS_MODEL_NAME=text-embedding-3-large
EMBEDDINGS_BASE_URL=
TAVILY_API_KEY=

# Hybrid Retrieval: Dense Vector + BM25, fused with weighted RRF.
HYBRID_DENSE_K=8
HYBRID_BM25_K=8
HYBRID_FINAL_K=3
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=1.0

TOKEN_BEARER_URL=/api/v1/auth/login
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
SUPER_ADMIN_EMAILS=[]
ACCESS_TOKEN_EXPIRY_MINS=60
REFRESH_TOKEN_EXPIRY_DAYS=1
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8501","http://localhost:8502"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=zhishu_refresh
ADMIN_REFRESH_COOKIE_NAME=zhishu_admin_refresh

# Redis distributed traffic governance. Docker Compose overrides REDIS_URL to
# the internal redis service; do not expose that service on a host port.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_KEY_PREFIX=zhishu:traffic
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ORDINARY_REQUESTS=60
RATE_LIMIT_AGENT_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_SIGNUP_REQUESTS=5
RATE_LIMIT_LOGIN_IP_REQUESTS=10
RATE_LIMIT_LOGIN_ACCOUNT_REQUESTS=5
RATE_LIMIT_REFRESH_SESSION_REQUESTS=30
RATE_LIMIT_REFRESH_IP_REQUESTS=60
RATE_LIMIT_PUBLIC_CONFIG_REQUESTS=60
RATE_LIMIT_FAILURE_RETRY_AFTER_SECONDS=5
# Only list reverse proxies that are permitted to supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# Host ports for the React user and administrator surfaces.
FRONTEND_PORT=8501
ADMIN_PORT=8502
PREVIEW_FRONTEND_PORT=8511
PREVIEW_ADMIN_PORT=8512
# Dedicated, active local accounts used by scripts/start-preview-after-acceptance.ps1
# and scripts/verify-preview.ps1. Keep their values only in the untracked .env.
PREVIEW_USER_EMAIL=
PREVIEW_USER_PASSWORD=
PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=
# Required only by the full real-AI stream assertion in verify-preview.ps1.
PREVIEW_REAL_AI_THREAD_ID=
PREVIEW_REAL_AI_MODEL_NAME=
PREVIEW_EXPECT_COOKIE_SECURE=false
PREVIEW_EXPECT_COOKIE_SAMESITE=Lax
E2E_BACKEND_PORT=18001
E2E_FRONTEND_PORT=18511
E2E_ADMIN_PORT=18512

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection
BACKEND_BASE_URL=http://localhost:8000/api/v1
