# Copy this file to .env and fill in your local secrets. Never commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=openai
MODEL_NAMES=["gpt-4o","gpt-4o-mini"]
MODEL_BASE_URL=
EMBEDDINGS_MODEL_NAME=text-embedding-3-large
EMBEDDINGS_BASE_URL=
TAVILY_API_KEY=

TOKEN_BEARER_URL=/api/v1/auth/login
ENVIRONMENT=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
SUPER_ADMIN_EMAILS=[]
ACCESS_TOKEN_EXPIRY_MINS=60
REFRESH_TOKEN_EXPIRY_DAYS=1
FRONTEND_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:8501","http://localhost:8502"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=zhishu_refresh
ADMIN_REFRESH_COOKIE_NAME=zhishu_admin_refresh

# Host ports for the React user and administrator surfaces.
FRONTEND_PORT=8501
ADMIN_PORT=8502
PREVIEW_FRONTEND_PORT=8511
PREVIEW_ADMIN_PORT=8512
# Dedicated, active local accounts used by scripts/start-preview-after-acceptance.ps1
# and scripts/verify-preview.ps1. Keep their values only in the untracked .env.
PREVIEW_USER_EMAIL=
PREVIEW_USER_PASSWORD=
PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=
# Required only by the full real-AI stream assertion in verify-preview.ps1.
PREVIEW_REAL_AI_THREAD_ID=
PREVIEW_REAL_AI_MODEL_NAME=
PREVIEW_EXPECT_COOKIE_SECURE=false
PREVIEW_EXPECT_COOKIE_SAMESITE=Lax
E2E_BACKEND_PORT=18001
E2E_FRONTEND_PORT=18511
E2E_ADMIN_PORT=18512

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection
BACKEND_BASE_URL=http://localhost:8000/api/v1
