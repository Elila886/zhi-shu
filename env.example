# Copy this file to .env and fill in your local secrets. Never commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER=openai
MODEL_NAMES=["gpt-4o","gpt-4o-mini"]
MODEL_BASE_URL=
EMBEDDINGS_MODEL_NAME=text-embedding-3-large
EMBEDDINGS_BASE_URL=
TAVILY_API_KEY=

TOKEN_BEARER_URL=/api/v1/auth/login
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
SUPER_ADMIN_EMAILS=[]
ACCESS_TOKEN_EXPIRY_MINS=60
REFRESH_TOKEN_EXPIRY_DAYS=1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DATABASE=langgraph_db
PGVECTOR_COLLECTION_NAME=my_collection
BACKEND_BASE_URL=http://localhost:8000/api/v1
